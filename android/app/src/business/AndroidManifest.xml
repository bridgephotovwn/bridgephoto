<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The company edition is the ONLY one allowed to reach the network: it
         sends scans to BRIDGE. Different app, different name on the phone,
         different package id, so it can sit beside the public app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="BRIDGE PHOTO Business"
        tools:replace="android:label" />
</manifest>
